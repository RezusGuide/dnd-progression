# Шаблон настроек бэкенда на домашнем ПК (docs/zlatopryady/HOME-HOSTING.md).
# Настоящий файл лежит ВНЕ репозитория: %LOCALAPPDATA%\zlatopryady\.env.home
# Не коммитьте его и никому не пересылайте.

# База Neon: Neon -> Connection details -> pooled, в формате JDBC.
DATABASE_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=<пароль Neon>

# Base64 от 48 случайных байт. Как сгенерировать - в HOME-HOSTING.md, шаг 3.
JWT_SECRET=<Base64-строка>

# Адрес сайта на Vercel (без / в конце). Для CORS и для ссылок в файлах .ics.
CORS_ALLOWED_ORIGINS=https://<сайт>.vercel.app
SITE_URL=https://<сайт>.vercel.app

# prod - строгие проверки настроек; home - слушать только 127.0.0.1 и писать лог в файл.
SPRING_PROFILES_ACTIVE=prod,home
